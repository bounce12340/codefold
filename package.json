{
  "name": "codefold",
  "displayName": "CodeFold",
  "description": "A foldable 2D workspace dependency canvas with an optional 3D showcase.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:codefold.open",
    "onCommand:codefold.open3d",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codefold.open",
        "title": "CodeFold: Open"
      },
      {
        "command": "codefold.open3d",
        "title": "CodeFold: Open 3D View"
      },
      {
        "command": "codefold.runTests",
        "title": "CodeFold: Run Tests"
      }
    ],
    "configuration": {
      "title": "CodeFold",
      "properties": {
        "codefold.openOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Open the CodeFold 2D canvas automatically when a workspace is loaded."
        },
        "codefold.runTestsOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run configured tests after a tracked source file is saved. Disabled by default because test commands may have side effects."
        },
        "codefold.testCommand.javascript": {
          "type": "string",
          "default": "",
          "description": "JS/TS test command. Empty auto-detects Jest from package.json, otherwise tries local Vitest without installing packages."
        },
        "codefold.testCommand.python": {
          "type": "string",
          "default": "",
          "description": "Python test command. Empty uses python -m coverage run -m pytest followed by coverage JSON generation."
        },
        "codefold.testCoverage.javascript": {
          "type": "string",
          "default": "coverage/coverage-final.json",
          "description": "Workspace-relative Istanbul/c8 JSON coverage file produced by the JS/TS test command."
        },
        "codefold.testCoverage.python": {
          "type": "string",
          "default": "coverage.json",
          "description": "Workspace-relative coverage.py JSON report produced by the Python test command."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "preview:build": "node tools/preview/build.mjs",
    "preview": "node tools/preview/serve.mjs",
    "preview:verify": "node tools/preview/verify.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "d3-force-3d": "^3.0.6",
    "globby": "^14.1.0",
    "three": "^0.179.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.11"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.0",
    "@types/three": "^0.179.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.11.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
